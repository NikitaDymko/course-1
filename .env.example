# =========================================================================
# Скопируйте этот файл в .env и при необходимости измените значения:
#   cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# Хост, по которому браузер и контейнеры обращаются к Keycloak.
# ВАЖНО: это значение попадает в issuer JWT-токена. Оно должно быть
# доступно и из браузера, и из контейнеров сервисов.
#
# Linux (по умолчанию):  172.17.0.1  (адрес docker0)
# Docker Desktop (macOS/Windows): host.docker.internal
# -------------------------------------------------------------------------
KEYCLOAK_HOST=172.17.0.1
KEYCLOAK_PORT=8088

# -------------------------------------------------------------------------
# Пароли инфраструктуры (учебные значения, менять не обязательно)
# -------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -------------------------------------------------------------------------
# SMTP для notification-service (Mailtrap sandbox)
# Зарегистрируйтесь на https://mailtrap.io и вставьте свои креды,
# иначе письма просто не будут отправляться (журнал уведомлений работает).
# -------------------------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# -------------------------------------------------------------------------
# Порты, публикуемые на хост.
# Наружу открыты только точки входа: веб-интерфейс, шлюз, Keycloak и
# Kafka UI. Сервисы, БД, Redis, Kafka и Schema Registry портов на хост
# не публикуют и доступны только внутри docker-сети по именам сервисов.
# -------------------------------------------------------------------------
WEB_UI_PORT=3000
API_GATEWAY_PORT=9000
KAFKA_UI_PORT=8086
